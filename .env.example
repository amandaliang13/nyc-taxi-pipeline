# Warehouse Postgres connection. Used by docker compose (compose.yaml) and by
# host-native dbt (dbt/nyc_taxi/profiles.yml.example) to reach the same DB.
# POSTGRES_HOST / POSTGRES_PORT are the host-side values (host-native dbt, pytest).
# compose.yaml overrides them to warehouse-db:5432 inside the Airflow containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyc_taxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# AWS credentials for the TLC -> S3 extract step (ingestion/extract.py) and the
# Airflow AWS connection (AIRFLOW_CONN_AWS_DEFAULT in compose.yaml).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 bucket for the raw/ landing zone (see ingestion/tlc.py for key addressing).
# Exposed to Airflow as the S3_BUCKET variable (AIRFLOW_VAR_S3_BUCKET).
S3_BUCKET_VAR=
